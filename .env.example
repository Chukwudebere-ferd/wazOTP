# ============================================
# wazOTP - Environment Variables Example
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================

# --- Server ---
PORT=3000
NODE_ENV=development
# Options: development, production

# ============================================
# Database - MySQL (REQUIRED)
# The app uses mysql2/promise, pool-based
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=wazotp

# Aliases also supported by codebase (use DB_* or DATABASE_* / DB_USERNAME etc):
# DATABASE_HOST=localhost
# DATABASE_USER=root
# DATABASE_PASSWORD=your_mysql_password
# DATABASE_NAME=wazotp
# DB_USERNAME=root

# Optional DB settings
DB_CONNECTION_LIMIT=10
DB_ENABLE_SSL=false
# Set to "true" to enable TLS (needed for managed DBs like Aiven, PlanetScale)
# DATABASE_ENABLE_SSL=false

# ============================================
# Firebase Admin SDK (REQUIRED)
# For user auth on dashboard - 3 options:
# ============================================

# OPTION 1 (Recommended for production/Vercel/Docker):
# Base64-encoded full service account JSON
# Generate with: cat firebase-service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT_BASE64=

# OPTION 2 (Individual env vars):
# Use these if you don't want base64
FIREBASE_PROJECT_ID=wapotp-1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@wapotp-1.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# OPTION 3 (Local development fallback):
# Place file at root: ./firebase-service-account.json
# .gitignore already excludes it

# --- Frontend Firebase Config (public, used in dashboard) ---
# These are hardcoded in src/lib/firebase-config.js but listed for reference
# Not required in .env, but useful if you want to override via env later
# FIREBASE_API_KEY=AIzaSyCPQ2VcawfpSCsrOpXCgC_S6BvmpUZDdyU
# FIREBASE_AUTH_DOMAIN=wapotp-1.firebaseapp.com
# FIREBASE_STORAGE_BUCKET=wapotp-1.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=538587920346
# FIREBASE_APP_ID=1:538587920346:web:ca7502e71a86649b6432e3

# ============================================
# Gemini AI - Chat Assistant (OPTIONAL)
# Powers /v1/chat endpoint - Dashboard AI Help
# Get key from https://aistudio.google.com/app/apikey
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_key_optional
# Second key is used as failover if first hits 429 quota

# ============================================
# Optional / Legacy (from README, not currently used in code but in package.json)
# Keep commented unless you plan to re-add support
# ============================================
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgres://user:pass@localhost:5432/wazotp
# PG - was listed in package.json but app currently uses MySQL

# ============================================
# Docker Notes
# - docker-compose.yml expects .env in project root
# - sessions are persisted to ./sessions (gitignored)
# ============================================
